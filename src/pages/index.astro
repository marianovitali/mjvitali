<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mariano Vitali - Redirecting...</title>
    <script>
        // Detecta el idioma del navegador (ej: 'es-AR', 'en-US')
        const userLang = navigator.language;
        
        // Si el idioma arranca con 'es', va a la versión en español
        if (userLang.toLowerCase().startsWith('es')) {
            window.location.replace('/es');
        } else {
            // Para cualquier otro idioma, va a inglés por defecto
            window.location.replace('/en');
        }
    </script>
</head>
<body>
</body>
</html>
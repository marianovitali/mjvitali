---
// 1. Importamos el layout (¡esto faltaba en tu captura!)
import MainLayout from '../../layouts/MainLayout.astro'; 

// 2. Importamos todos los componentes
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import TechStack from '../../components/TechStack.astro';
import Projects from '../../components/Projects.astro';
import Education from '../../components/Education.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';

// 3. Importamos los datos
import { site } from '../../data/site.js';

const lang = "es";
const currentSiteData = { ...site, ...site[lang] };
---

<MainLayout title={`${currentSiteData.name} - ${currentSiteData.role}`}>
    <Navbar lang={lang} />
    
<main>
        <Hero data={currentSiteData} lang={lang} />
        <About lang={lang} />
        <TechStack lang={lang} />
        <Projects lang={lang} />
        <Education lang={lang} />
        <Contact lang={lang} />
    </main>

    <Footer />
</MainLayout>
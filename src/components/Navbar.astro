---
import { Icon } from "astro-icon/components";

const { lang = "en" } = Astro.props;
---

<header class="navbar">
    <div class="nav-container">
        <div class="nav-brand">
            <a href={`/${lang}`} class="nav-logo">
                <Icon name="lucide:code-xml" size={24} class="logo-icon" />
            </a>
            <a href={`/${lang}`} class="nav-logo"> MV. </a>

            <div class="lang-switch">
                <a href="/en" class={lang === "en" ? "active" : ""}>EN</a>
                <span class="separator">/</span>
                <a href="/es" class={lang === "es" ? "active" : ""}>ES</a>
            </div>
        </div>

        <div class="nav-right">
            <nav class="nav-links" id="nav-links">
                <a href="#home"> {lang === "en" ? "Home" : "Inicio"} </a>
                <a href="#about"> {lang === "en" ? "About" : "Sobre mí"} </a>
                <a href="#stack"> Stack </a>
                <a href="#projects">
                    {lang === "en" ? "Projects" : "Proyectos"}
                </a>
                <a href="#education">
                    {lang === "en" ? "Education" : "Educación"}
                </a>
                <a href="#contact">
                    {lang === "en" ? "Contact" : "Contacto"}
                </a>
            </nav>
            <button
                id="theme-toggle"
                aria-label="Toggle dark mode"
                title="Toggle dark mode"
            >
                <Icon
                    id="theme-icon-moon"
                    name="lucide:moon"
                    size={20}
                    class="theme-icon"
                />
                <Icon
                    id="theme-icon-sun"
                    name="lucide:sun"
                    size={20}
                    class="theme-icon"
                />
            </button>

            <button
                id="mobile-menu-btn"
                aria-label="Menú"
                class="mobile-toggle"
            >
                <Icon name="lucide:menu" size={24} />
            </button>
        </div>
    </div>
</header>

<style>
    .navbar {
        position: sticky;
        top: 0;
        z-index: 1000;
        backdrop-filter: blur(10px);
        background-color: color-mix(in srgb, var(--color-bg) 40%, transparent);
        border-bottom: 0px solid var(--color-border);
    }

    .nav-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .nav-brand {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .nav-logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.4rem;
        font-weight: 800;
        letter-spacing: -0.04em;
        color: var(--color-text);
    }

    .lang-switch {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--color-text-muted);
        background: var(--color-primary-soft, rgba(0, 0, 0, 0.05));
        padding: 0.3rem 0.6rem;
        border-radius: 6px;
    }

    .lang-switch a {
        color: var(--color-text-muted);
        transition: color 0.2s ease;
    }

    .lang-switch a:hover {
        color: var(--color-text);
    }

    .lang-switch a.active {
        color: var(--color-primary);
        pointer-events: none;
    }

    .separator {
        color: var(--color-border, #ccc);
        font-weight: 400;
    }

    
    .nav-right {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .mobile-toggle {
        display: none;
        background: transparent;
        border: none;
        color: var(--color-text);
        cursor: pointer;
        padding: 0.5rem;
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .nav-links a {
        color: var(--color-text-muted);
        font-size: 0.9rem;
        font-weight: 600;
        transition: color 0.2s ease;
        padding: 0.1rem 0.1rem;
        border-radius: 8px; 
        transition: all 0.2s ease;
    }

    .nav-links a:hover {
        color: var(--color-text);
        background-color: var(--color-primary-soft, rgba(0, 180, 216, 0.15));
    }

    #theme-toggle {
        border: none;
        background: transparent;
        cursor: pointer;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text);
        padding: 0.5rem;
    }

    @media (max-width: 800px) {
        .mobile-toggle {
            display: block;
        }

        .nav-right {
            gap: 0.5rem;
        }

        .nav-links {
            display: none;
            flex-direction: column;
            align-items: center;
            position: absolute;
            top: 100%;
            left: 0;
            width: 100%;
            background-color: var(--color-bg);
            padding: 1.5rem 2rem;
            gap: 1.5rem;
            border-bottom: 1px solid var(--color-border);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .nav-links.active {
            display: flex;
        }
    }

    :focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 4px;
    }
</style>

<script>
    function setupMobileMenu() {
        const menuBtn = document.getElementById("mobile-menu-btn");
        const navLinks = document.getElementById("nav-links");
        const links = navLinks?.querySelectorAll("a");

        if (menuBtn && navLinks) {
            menuBtn.onclick = () => {
                navLinks.classList.toggle("active");
            };

            links?.forEach((link) => {
                link.onclick = () => {
                    navLinks.classList.remove("active");
                };
            });
        }
    }

    setupMobileMenu();
    document.addEventListener("astro:after-swap", setupMobileMenu);
</script>

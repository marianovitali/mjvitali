---
import { education } from "../data/education.js";

interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props as Props;
const data = education[lang];
---

<section id="education" class="section">
  <h2>{data.title}</h2>

  <div class="education-group">
    <h3 class="education-title">{data.academicTitle}</h3>

    <div class="education-grid">
      <div class="card education-card">
        <div class="card-header">
          <h3>{data.academic[0].title}</h3>

          <span class="period"> {data.academic[0].badge} </span>
        </div>

        <p class="institution">{data.academic[0].institution}</p>

        <p class="description">{data.academic[0].description}</p>
      </div>

      <div class="card education-card">
        <div class="card-header">
          <h3>{data.academic[1].title}</h3>

          <span class="period"> {data.academic[1].badge} </span>
        </div>

        <p class="institution">
          {data.academic[1].institution}
        </p>

        <p class="description">{data.academic[1].description}</p>
      </div>
    </div>
  </div>

  <div class="education-group courses-group">
    <h3 class="education-title">{data.coursesTitle}</h3>

    <div class="courses-grid">
      <div class="card course-card">
        <h3>{data.courses[0].title}</h3>

        <p>{data.courses[0].description}</p>

        <span> {data.courses[0].issuer} </span>
      </div>

      <div class="card course-card">
        <h3>{data.courses[1].title}</h3>

        <p>{data.courses[1].description}</p>

        <span> {data.courses[1].issuer} </span>
      </div>

      <div class="card course-card">
        <h3>{data.courses[2].title}</h3>

        <p>{data.courses[2].description}</p>

        <span> {data.courses[2].issuer} </span>
      </div>

      <div class="card course-card">
        <h3>{data.courses[3].title}</h3>

        <p>{data.courses[3].description}</p>

        <span> {data.courses[3].issuer} </span>
      </div>

      <div class="card course-card">
        <h3>{data.courses[4].title}</h3>

        <p>{data.courses[4].description}</p>

        <span> {data.courses[4].issuer} </span>
      </div>
    </div>
  </div>
</section>

<style>
  .education-grid {
    display: grid;

    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));

    gap: 1.5rem;
  }

  .education-card {
    display: flex;

    flex-direction: column;

    gap: 0.75rem;
  }

  .education-group {
    margin-bottom: 3rem;
  }

  .education-title {
    font-size: 1.25rem;

    margin-bottom: 1.5rem;

    color: var(--color-primary);
  }

  .card-header {
    display: flex;

    justify-content: space-between;

    align-items: flex-start;

    gap: 1rem;
  }

  .period {
    font-size: 0.8rem;

    font-weight: 600;

    color: var(--color-primary);

    background-color: var(--color-primary-soft);

    padding: 0.25rem 0.5rem;

    border-radius: 4px;

    white-space: nowrap;
  }

  .institution {
    font-weight: 500;

    color: var(--color-text);

    font-size: 0.95rem;
  }

  .description {
    color: var(--color-text-muted);

    font-size: 0.9rem;
  }

  .courses-grid {
    display: grid;

    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));

    gap: 1.5rem;
  }

  .course-card {
    display: flex;

    flex-direction: column;

    gap: 0.75rem;
  }

  .course-card h3 {
    font-size: 1.1rem;
  }

  .course-card p {
    color: var(--color-text-muted);

    font-size: 0.9rem;

    flex-grow: 1;
  }

  .course-card span {
    color: var(--color-primary);

    font-size: 0.85rem;

    font-weight: 600;
  }
</style>

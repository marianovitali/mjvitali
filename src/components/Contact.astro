---
import { site } from "../data/site.js";
import { Icon } from "astro-icon/components";
import { contact } from "../data/contact.js";

interface Props {
    lang?: "en" | "es";
}
const { lang = "en" } = Astro.props as Props;
const data = contact[lang];
---

<section id="contact" class="section">
    <div class="card contact-card">
        <h2>{data.title}</h2>
        <p>
            {data.description}
        </p>
        <a href={`mailto:${site.email}`} class="btn btn-primary"
            >{data.buttonText}</a
        >
    </div>
</section>

<style>
    .contact-card {
        display: flex;

        flex-direction: column;

        align-items: center;

        text-align: center;

        gap: 1.5rem;

        max-width: 600px;

        margin: 0 auto;

        padding: 3rem 2rem;
    }

    .contact-card p {
        color: var(--color-text-muted);
    }
</style>
